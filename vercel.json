{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/n-s-26", "destination": "/n-s-26/index.html" },
    { "source": "/n-s-26/", "destination": "/n-s-26/index.html" },
    { "source": "/n-s-26/((?!assets/)(?!.*\\.).*)", "destination": "/n-s-26/index.html" },
    { "source": "/s-b-sm-26", "destination": "/s-b-sm-26/index.html" },
    { "source": "/s-b-sm-26/", "destination": "/s-b-sm-26/index.html" },
    { "source": "/s-b-sm-26/((?!assets/)(?!.*\\.).*)", "destination": "/s-b-sm-26/index.html" }
  ],
  "redirects": [
    {
      "source": "/s-b-sm-26/apk/s-b-sm-26.apk",
      "destination": "https://github.com/krejirka/N-S-26/releases/latest/download/s-b-sm-26.apk",
      "permanent": false
    }
  ]
}
