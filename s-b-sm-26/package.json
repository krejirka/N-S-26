{
  "name": "s-b-sm-26",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "import:itinerary": "node scripts/import-itinerary.mjs",
    "build:routes": "node scripts/build-routes.mjs",
    "fetch:pois": "node scripts/fetch-corridor-pois.mjs",
    "fetch:chargers": "node scripts/fetch-ev-chargers.mjs",
    "enrich:chargers": "node scripts/enrich-ev-chargers.mjs",
    "fetch:hike": "node scripts/fetch-hike-musala.mjs && node scripts/fetch-hike-elevation.mjs",
    "fetch:hike-elevation": "node scripts/fetch-hike-elevation.mjs",
    "fetch:fuel": "node scripts/fetch-fuel.mjs",
    "fetch:borders": "node ../scripts/fetch-border-crossings.mjs",
    "seed:pois": "node scripts/seed-corridor-pois.mjs",
    "data": "npm run import:itinerary && npm run build:routes",
    "maps:offline": "node scripts/extract-offline-maps.mjs && node scripts/download-hike-tiles.mjs",
    "build:native": "node scripts/clean-public-apk.mjs && vite build --mode native",
    "cap:sync": "npm run build:native && npx cap sync android",
    "apk": "npm run cap:sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "pmtiles": "^4.3.0",
    "protomaps-leaflet": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
